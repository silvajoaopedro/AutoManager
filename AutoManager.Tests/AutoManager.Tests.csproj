<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes automatizados do AutoManager.
    Executar com: dotnet run (na pasta AutoManager.Tests)
    Não depende de pacotes NuGet externos: usa um executor de testes próprio (MiniTeste).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoManager.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\AutoManager\AutoManager.csproj" />
  </ItemGroup>

</Project>
