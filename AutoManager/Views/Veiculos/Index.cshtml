@model VeiculoListaViewModel
@{
    ViewData["Title"] = "Veículos";
    var podeEditar = User.EhAtendente();
}
<div class="am-page-header">
    <div>
        <h1>Veículos</h1>
        <p>@Model.Total veículo(s) cadastrado(s).</p>
    </div>
    @if (podeEditar)
    {
        <div class="am-page-actions">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Novo veículo</a>
        </div>
    }
</div>

<div class="am-card">
    <form method="get" asp-action="Index" class="am-toolbar">
        <div class="am-search">
            <i class="bi bi-search"></i>
            <input type="search" name="busca" value="@Model.Busca" class="form-control" placeholder="Pesquisar pela placa, modelo ou proprietário" aria-label="Pesquisar veículos" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-dark">Pesquisar</button>
            @if (!string.IsNullOrWhiteSpace(Model.Busca))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
            }
        </div>
    </form>

    @if (Model.Itens.Count == 0)
    {
        <div class="am-empty">
            <i class="bi bi-car-front"></i>
            @if (string.IsNullOrWhiteSpace(Model.Busca))
            {
                <h3>Nenhum veículo cadastrado</h3>
                <p>Cadastre o cliente e, em seguida, o veículo.</p>
            }
            else
            {
                <h3>Nenhum veículo encontrado para “@Model.Busca”</h3>
                <p>Se for a primeira visita, cadastre o cliente e o veículo.</p>
            }
            @if (podeEditar)
            {
                <div class="d-flex gap-2 justify-content-center flex-wrap">
                    <a asp-controller="Clientes" asp-action="Create" class="btn btn-outline-secondary"><i class="bi bi-person-plus"></i> Novo cliente</a>
                    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Novo veículo</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table am-table am-table-stack">
                <thead>
                    <tr>
                        <th>Placa</th>
                        <th>Veículo</th>
                        <th>Proprietário</th>
                        <th>Serviços</th>
                        <th class="col-actions"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Itens)
                    {
                        <tr data-am-href="@Url.Action("Details", new { id = v.Id })">
                            <td data-label="Placa"><partial name="_Placa" model="v.Placa" /></td>
                            <td data-label="Veículo">
                                <a asp-action="Details" asp-route-id="@v.Id" class="cell-title">@v.Descricao</a>
                                <div class="cell-sub">@(v.Ano?.ToString() ?? "")@(v.Ano.HasValue && !string.IsNullOrEmpty(v.Cor) ? " · " : "")@v.Cor</div>
                            </td>
                            <td data-label="Proprietário"><a asp-controller="Clientes" asp-action="Details" asp-route-id="@v.ClienteId" class="cell-title fw-medium">@v.ClienteNome</a></td>
                            <td data-label="Serviços" class="cell-sub">
                                @v.TotalOrdens ordem(ns)
                                @if (v.OrdensAbertas > 0)
                                {
                                    <span class="status-badge status-andamento ms-1" style="font-size:.7rem;padding:.1rem .45rem">@v.OrdensAbertas em aberto</span>
                                }
                            </td>
                            <td class="col-actions">
                                @if (podeEditar)
                                {
                                    <a asp-controller="OrdensServico" asp-action="Create" asp-route-veiculoId="@v.Id" class="btn btn-sm btn-primary"><i class="bi bi-clipboard2-plus"></i> Abrir OS</a>
                                }
                                <a asp-action="Details" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
