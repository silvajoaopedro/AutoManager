@model VeiculoFormViewModel
@{
    ViewData["Title"] = "Novo veículo";
}
<div class="am-page-header">
    <div>
        <div class="am-breadcrumb"><a asp-action="Index">Veículos</a><i class="bi bi-chevron-right"></i>Novo veículo</div>
        <h1>Cadastrar veículo</h1>
        <p>Campos marcados com <span class="text-danger">*</span> são obrigatórios.</p>
    </div>
</div>

<div class="am-flow" aria-label="Etapas do atendimento">
    <span class="@(Model.ClienteFixo ? "done" : "")"><i class="bi @(Model.ClienteFixo ? "bi-check-lg" : "bi-person")"></i> 1. Cliente</span><i class="bi bi-chevron-right"></i>
    <span class="active"><i class="bi bi-car-front"></i> 2. Veículo</span><i class="bi bi-chevron-right"></i>
    <span><i class="bi bi-clipboard2-plus"></i> 3. Ordem de serviço</span>
</div>

<div class="row">
    <div class="col-xl-8">
        <form asp-action="Create" method="post" class="am-card" novalidate data-am-once>
            <div class="am-card-body">
                <partial name="_Form" model="Model" />
            </div>
            <div class="am-card-footer am-form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Salvar veículo</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
