@{
    ViewData["Title"] = "Acesso negado";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_LayoutAuth";
}
<div class="am-error-page px-3">
    <div class="code"><i class="bi bi-shield-lock"></i></div>
    <h1 class="h4 mt-3">Acesso não permitido para o seu perfil</h1>
    <p class="text-muted">
        Esta operação é exclusiva de outro perfil de usuário.
        @if (User.Identity?.IsAuthenticated == true)
        {
            <text>Você está conectado como <strong>@User.ObterUsuario().Perfil.Nome()</strong>.</text>
        }
    </p>
    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Voltar ao dashboard</a>
</div>
