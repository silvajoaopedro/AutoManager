@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_LayoutAuth";
}
<div class="am-error-page px-3">
    <div class="code">Ops!</div>
    <h1 class="h4 mt-3">Não foi possível concluir a solicitação</h1>
    <p class="text-muted">Ocorreu um erro inesperado. Nenhum dado parcial foi gravado. Tente novamente em instantes.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted">Código da ocorrência: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Voltar ao início</a>
</div>
