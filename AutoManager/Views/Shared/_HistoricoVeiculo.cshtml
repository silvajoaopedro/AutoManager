@model List<OrdemServico>
@*
    Histórico de serviços do veículo (RN15): gerado a partir das ordens armazenadas,
    exibindo datas, problema relatado, status e observações de cada ordem.
*@
@if (Model.Count == 0)
{
    <div class="am-empty">
        <i class="bi bi-clock-history"></i>
        <h3>Sem serviços registrados</h3>
        <p>As ordens de serviço deste veículo aparecerão aqui.</p>
    </div>
}
else
{
    <div class="am-card-body">
        <ul class="am-timeline">
            @foreach (var o in Model)
            {
                var tom = o.Status switch { StatusOrdem.Pendente => "pendente", StatusOrdem.EmAndamento => "andamento", _ => "concluida" };
                <li>
                    <span class="am-timeline-dot @tom"><i class="bi @o.Status.Icone()"></i></span>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <a asp-controller="OrdensServico" asp-action="Details" asp-route-id="@o.Numero" class="fw-bold text-decoration-none" style="color:var(--am-text)">@o.NumeroFormatado</a>
                        <partial name="_StatusBadge" model="o.Status" />
                    </div>
                    <div class="am-meta-row mb-2">
                        <span><i class="bi bi-calendar-plus"></i>Aberta em @Formatacao.DataHora(o.DataAbertura)</span>
                        @if (o.DataConclusao.HasValue)
                        {
                            <span><i class="bi bi-calendar-check"></i>Concluída em @Formatacao.DataHora(o.DataConclusao)</span>
                        }
                    </div>
                    <p class="am-quote mb-2"><strong class="d-block small text-muted mb-1">Problema relatado</strong>@o.DescricaoProblema</p>
                    @if (o.Observacoes.Count > 0)
                    {
                        <details class="small" @(o.Observacoes.Count <= 2 ? "open" : "")>
                            <summary class="text-muted fw-semibold mb-2" style="cursor:pointer">@o.Observacoes.Count observação(ões) registrada(s)</summary>
                            @foreach (var obs in o.Observacoes)
                            {
                                <div class="mb-2">
                                    <div class="am-timeline-meta"><strong>@obs.UsuarioNome</strong> · @obs.UsuarioPerfil.Nome() · @Formatacao.DataHora(obs.DataHora)@(obs.Tipo == TipoObservacao.Conclusao ? " · Conclusão" : "")</div>
                                    <div class="am-timeline-text @(obs.Tipo == TipoObservacao.Conclusao ? "conclusao" : "")">@obs.Texto</div>
                                </div>
                            }
                        </details>
                    }
                </li>
            }
        </ul>
    </div>
}
