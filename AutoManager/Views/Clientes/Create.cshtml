@model ClienteFormViewModel
@{
    ViewData["Title"] = "Novo cliente";
}
<div class="am-page-header">
    <div>
        <div class="am-breadcrumb"><a asp-action="Index">Clientes</a><i class="bi bi-chevron-right"></i>Novo cliente</div>
        <h1>Cadastrar cliente</h1>
        <p>Campos marcados com <span class="text-danger">*</span> são obrigatórios.</p>
    </div>
</div>

<div class="am-flow" aria-label="Etapas do atendimento">
    <span class="active"><i class="bi bi-person"></i> 1. Cliente</span><i class="bi bi-chevron-right"></i>
    <span><i class="bi bi-car-front"></i> 2. Veículo</span><i class="bi bi-chevron-right"></i>
    <span><i class="bi bi-clipboard2-plus"></i> 3. Ordem de serviço</span>
</div>

<div class="row">
    <div class="col-xl-8">
        <form asp-action="Create" method="post" class="am-card" novalidate data-am-once>
            <div class="am-card-body">
                <partial name="_Form" model="Model" />
            </div>
            <div class="am-card-footer am-form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" name="continuar" value="" class="btn btn-outline-secondary"><i class="bi bi-check2"></i> Salvar cliente</button>
                <button type="submit" name="continuar" value="veiculo" class="btn btn-primary">Salvar e cadastrar veículo <i class="bi bi-arrow-right"></i></button>
            </div>
        </form>
    </div>
    <div class="col-xl-4 mt-3 mt-xl-0">
        <div class="am-card am-card-body">
            <h2 class="h6 fw-bold"><i class="bi bi-lightbulb me-1 text-warning"></i> Antes de cadastrar</h2>
            <p class="small text-muted mb-2">Confira se o cliente já possui cadastro pesquisando pelo nome, telefone ou placa do veículo.</p>
            <form asp-action="Index" method="get" class="am-search mw-100">
                <i class="bi bi-search"></i>
                <input name="busca" class="form-control" placeholder="Nome, telefone ou placa" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
