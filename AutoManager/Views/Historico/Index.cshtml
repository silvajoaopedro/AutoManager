@model HistoricoListaViewModel
@{
    ViewData["Title"] = "Histórico de serviços";
}
<div class="am-page-header">
    <div>
        <h1>Histórico de serviços</h1>
        <p>@Model.TotalOrdens ordem(ns) registradas · @Model.TotalConcluidas concluída(s).</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="am-card">
            <form method="get" asp-action="Index" class="am-toolbar">
                <div class="am-search">
                    <i class="bi bi-search"></i>
                    <input type="search" name="busca" value="@Model.Busca" class="form-control" placeholder="Pesquisar pela placa, veículo ou cliente" aria-label="Pesquisar histórico" autofocus />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark">Pesquisar</button>
                    @if (!string.IsNullOrWhiteSpace(Model.Busca))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
                    }
                </div>
            </form>

            @if (Model.Itens.Count == 0)
            {
                <div class="am-empty">
                    <i class="bi bi-clock-history"></i>
                    <h3>@(string.IsNullOrWhiteSpace(Model.Busca) ? "Nenhum serviço registrado ainda" : $"Nenhum histórico encontrado para “{Model.Busca}”")</h3>
                    <p>O histórico é formado pelas ordens de serviço de cada veículo.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table am-table am-table-stack">
                        <thead>
                            <tr><th>Placa</th><th>Veículo</th><th>Proprietário</th><th>Ordens</th><th>Último serviço</th><th class="col-actions"><span class="visually-hidden">Ações</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Itens)
                            {
                                var v = item.Veiculo;
                                <tr data-am-href="@Url.Action("Veiculo", new { id = v.Id })">
                                    <td data-label="Placa"><partial name="_Placa" model="v.Placa" /></td>
                                    <td data-label="Veículo"><span class="cell-title">@v.Descricao</span></td>
                                    <td data-label="Proprietário">@v.ClienteNome</td>
                                    <td data-label="Ordens" class="cell-sub">@v.TotalOrdens no total · @item.Concluidas concluída(s)</td>
                                    <td data-label="Último serviço" class="cell-sub">@(item.UltimoServico.HasValue ? Formatacao.Data(item.UltimoServico.Value) : "—")</td>
                                    <td class="col-actions"><a asp-action="Veiculo" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary">Ver histórico</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-xl-4">
        <div class="am-card">
            <div class="am-card-header"><h2><i class="bi bi-check2-circle"></i> Concluídas recentemente</h2></div>
            @if (Model.UltimasConcluidas.Count == 0)
            {
                <div class="am-card-body text-muted small">Nenhuma ordem concluída.</div>
            }
            else
            {
                @foreach (var o in Model.UltimasConcluidas)
                {
                    <a class="am-queue-item" asp-controller="OrdensServico" asp-action="Details" asp-route-id="@o.Numero">
                        <partial name="_Placa" model="o.Placa" />
                        <div class="am-queue-main">
                            <div class="am-queue-title">@o.NumeroFormatado <span class="cell-sub fw-normal">· @o.Veiculo</span></div>
                            <div class="am-queue-desc">@o.DescricaoProblema</div>
                        </div>
                        <span class="cell-sub text-nowrap">@(o.DataConclusao.HasValue ? Formatacao.Data(o.DataConclusao.Value) : "")</span>
                    </a>
                }
            }
        </div>
    </div>
</div>
