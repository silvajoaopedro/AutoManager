@using AutoManager.Models
@{
    ViewData["Title"] = "Abrir ordem de serviço";
    var veiculos = (IEnumerable<Veiculo>?)ViewBag.Veiculos ?? Array.Empty<Veiculo>();
}
<h1 class="mb-3">Nova ordem de serviço</h1>
<form asp-action="Abrir" method="post" asp-antiforgery="true" class="card shadow-sm p-4" style="max-width:720px">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label for="veiculoId" class="form-label">Veículo *</label>
        <select name="veiculoId" id="veiculoId" class="form-select" required>
            <option value="">Selecione um veículo</option>
            @foreach (var v in veiculos)
            {
                <option value="@v.Id" selected="@(ViewBag.VeiculoId != null && (Guid)ViewBag.VeiculoId == v.Id)">@v.Placa — @v.Marca @v.Modelo</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label for="problema" class="form-label">Problema relatado *</label>
        <textarea name="problema" id="problema" rows="4" class="form-control" required maxlength="2000">@ViewBag.Problema</textarea>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Abrir ordem</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
