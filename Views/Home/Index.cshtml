@model PainelOficinaViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Visão geral";
    var ptBr = CultureInfo.GetCultureInfo("pt-BR");
    var total = Model.Pendentes + Model.EmAndamento + Model.Concluidas;
    var picoConclusoes = Math.Max(1, Model.ConclusoesPorDia.Max());
    var conclusoesSemana = Model.ConclusoesPorDia.Sum();
    var fimPeriodo = Model.InicioPeriodo.AddDays(Model.ConclusoesPorDia.Count - 1);
    var etapas = new[]
    {
        (Status: StatusOrdem.Pendente, Nome: "Pendentes", Singular: "Pendente", Total: Model.Pendentes,
            Tom: "pendente", Icone: "relogio", Resumo: "Aguardando início do serviço", Etapa: "Prontas para começar"),
        (Status: StatusOrdem.EmAndamento, Nome: "Em andamento", Singular: "Em andamento", Total: Model.EmAndamento,
            Tom: "andamento", Icone: "chave", Resumo: "Serviços em execução", Etapa: "A oficina em movimento"),
        (Status: StatusOrdem.Concluida, Nome: "Concluídas", Singular: "Concluída", Total: Model.Concluidas,
            Tom: "concluida", Icone: "concluido", Resumo: "Histórico preservado", Etapa: "Serviços finalizados")
    };
}

<div class="painel">
    <header class="painel-cabecalho">
        <div>
            <p class="painel-sobretitulo"><span aria-hidden="true"></span>Seu dia na oficina</p>
            <h1>Visão geral<span aria-hidden="true">.</span></h1>
            <p class="painel-subtitulo">Tudo o que sua oficina precisa acompanhar, em um só lugar.</p>
        </div>
        @if (User.IsInRole("Atendente"))
        {
            <a class="btn oficina-nova painel-nova" href="@Url.Action("Abrir", "Ordens")" aria-label="Nova ordem de serviço">
                <partial name="_Icone" model="@("mais")" />
                <span class="painel-nova-texto">Nova ordem de serviço</span>
                <span class="painel-nova-curto">Nova OS</span>
            </a>
        }
    </header>

    <section class="painel-indicadores" aria-labelledby="titulo-indicadores">
        <h2 id="titulo-indicadores" class="visually-hidden">Indicadores das ordens de serviço</h2>
        <a class="painel-cartao painel-indicador" href="@Url.Action("Index", "Ordens")">
            <span class="painel-indicador-topo">
                <span>Total de ordens</span>
                <span class="painel-icone painel-icone-neutro"><partial name="_Icone" model="@("prancheta")" /></span>
            </span>
            <strong>@total.ToString("00")</strong>
            <small><span class="painel-ponto painel-ponto-neutro" aria-hidden="true"></span>Todas as ordens cadastradas</small>
        </a>
        @foreach (var etapa in etapas)
        {
            <a class="painel-cartao painel-indicador" href="@Url.Action("Index", "Ordens", new { status = etapa.Status })">
                <span class="painel-indicador-topo">
                    <span>@etapa.Nome</span>
                    <span class="painel-icone painel-icone-@etapa.Tom"><partial name="_Icone" model="@etapa.Icone" /></span>
                </span>
                <strong>@etapa.Total.ToString("00")</strong>
                <small><span class="painel-ponto painel-ponto-@etapa.Tom" aria-hidden="true"></span>@etapa.Resumo</small>
            </a>
        }
    </section>

    <div class="painel-resumo">
        <section class="painel-cartao painel-bloco" aria-labelledby="titulo-fluxo">
            <div class="painel-bloco-topo">
                <div>
                    <h2 id="titulo-fluxo">Cada serviço, no seu caminho</h2>
                    <p>Um fluxo simples, do primeiro atendimento à conclusão.</p>
                </div>
                <span class="painel-bloco-icone"><partial name="_Icone" model="@("fluxo")" /></span>
            </div>
            <ol class="painel-etapas">
                @for (var i = 0; i < etapas.Length; i++)
                {
                    var etapa = etapas[i];
                    <li>
                        <a class="painel-etapa painel-etapa-@etapa.Tom" href="@Url.Action("Index", "Ordens", new { status = etapa.Status })">
                            <span class="painel-etapa-numero">@((i + 1).ToString("00"))</span>
                            <strong>@etapa.Total.ToString("00")</strong>
                            <span class="painel-etapa-nome">@etapa.Singular</span>
                            <span class="painel-etapa-desc">@etapa.Etapa</span>
                        </a>
                        @if (i < etapas.Length - 1)
                        {
                            <span class="painel-etapa-seta" aria-hidden="true"><partial name="_Icone" model="@("seta")" /></span>
                        }
                    </li>
                }
            </ol>
            <p class="painel-rodape">Selecione uma etapa para ver as ordens filtradas por status.</p>
        </section>

        <section class="painel-cartao painel-bloco" aria-labelledby="titulo-ritmo">
            <div class="painel-bloco-topo">
                <div>
                    <h2 id="titulo-ritmo">Ritmo da oficina</h2>
                    <p>Serviços concluídos nos últimos 7 dias</p>
                </div>
                <strong class="painel-ritmo-total" aria-label="@conclusoesSemana concluídas no período">@conclusoesSemana</strong>
            </div>
            <ul class="painel-grafico">
                @for (var dia = 0; dia < Model.ConclusoesPorDia.Count; dia++)
                {
                    var quantidade = Model.ConclusoesPorDia[dia];
                    var data = Model.InicioPeriodo.AddDays(dia);
                    var altura = quantidade == 0 ? 4 : Math.Max(12, quantidade * 100 / picoConclusoes);
                    var ehHoje = dia == Model.ConclusoesPorDia.Count - 1;
                    <li class="@(ehHoje ? "painel-grafico-hoje" : null)">
                        <span class="painel-grafico-valor" aria-hidden="true">@quantidade</span>
                        <span class="painel-grafico-trilho" aria-hidden="true">
                            <span class="painel-grafico-barra" style="height: @altura%"></span>
                        </span>
                        <span class="painel-grafico-dia" aria-hidden="true">@data.ToString("ddd", ptBr).TrimEnd('.')</span>
                        <span class="visually-hidden">@data.ToString("dddd, dd/MM", ptBr): @quantidade @(quantidade == 1 ? "ordem concluída" : "ordens concluídas")</span>
                    </li>
                }
            </ul>
            <p class="painel-rodape painel-rodape-grafico">
                <span><span class="painel-ponto painel-ponto-concluida" aria-hidden="true"></span>Conclusões registradas</span>
                <strong>@Model.InicioPeriodo.ToString("d MMM", ptBr) — @fimPeriodo.ToString("d MMM", ptBr)</strong>
            </p>
        </section>
    </div>

    <section class="painel-cartao painel-recentes" aria-labelledby="titulo-recentes">
        <div class="painel-bloco-topo">
            <div>
                <h2 id="titulo-recentes">Ordens recentes</h2>
                <p>Acompanhe os detalhes e dê o próximo passo.</p>
            </div>
            <a class="painel-ver-todas" href="@Url.Action("Index", "Ordens")">
                Ver todas <partial name="_Icone" model="@("avancar")" />
            </a>
        </div>
        @if (Model.OrdensRecentes.Count == 0)
        {
            <p class="painel-vazio">Ainda não há ordens de serviço cadastradas.</p>
        }
        else
        {
            <table class="painel-tabela">
                <thead>
                    <tr>
                        <th scope="col">Ordem</th>
                        <th scope="col">Veículo / Cliente</th>
                        <th scope="col">Status</th>
                        <th scope="col">Abertura</th>
                        <th scope="col"><span class="visually-hidden">Detalhes</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ordem in Model.OrdensRecentes)
                    {
                        var etapa = etapas.First(item => item.Status == ordem.Status);
                        Model.Veiculos.TryGetValue(ordem.VeiculoId, out var veiculo);
                        Cliente? cliente = null;
                        if (veiculo is not null)
                            Model.Clientes.TryGetValue(veiculo.ClienteId, out cliente);
                        var abertura = ordem.DataAbertura.ToLocalTime();
                        var detalheVeiculo = string.Join(" · ", new[] { veiculo?.Placa, cliente?.Nome }.Where(texto => !string.IsNullOrEmpty(texto)));
                        <tr>
                            <td class="painel-tabela-numero">#OS-@ordem.Numero</td>
                            <td>
                                <span class="painel-veiculo">
                                    <span class="painel-veiculo-icone"><partial name="_Icone" model="@("carro")" /></span>
                                    <span>
                                        <strong>@(veiculo is null ? "Veículo indisponível" : $"{veiculo.Marca} {veiculo.Modelo}")</strong>
                                        <small>@detalheVeiculo</small>
                                    </span>
                                </span>
                            </td>
                            <td><span class="painel-status painel-status-@etapa.Tom">@etapa.Singular</span></td>
                            <td class="painel-tabela-data">
                                <time datetime="@abertura.ToString("o")">@abertura.ToString("d MMM", ptBr) <br />@abertura.ToString("HH:mm")</time>
                            </td>
                            <td class="painel-tabela-acao">
                                <a href="@Url.Action("Detalhes", "Ordens", new { numero = ordem.Numero })"
                                   aria-label="Ver detalhes da ordem #@ordem.Numero">
                                    <span class="painel-tabela-acao-texto">Ver detalhes</span>
                                    <partial name="_Icone" model="@("avancar")" />
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>
