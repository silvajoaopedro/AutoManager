@model PainelOficinaViewModel
@{
    ViewData["Title"] = "Painel da oficina";
    var etapas = new[]
    {
        (Status: StatusOrdem.Pendente, Nome: "Pendentes", Total: Model.Pendentes, Cor: "warning"),
        (Status: StatusOrdem.EmAndamento, Nome: "Em andamento", Total: Model.EmAndamento, Cor: "primary"),
        (Status: StatusOrdem.Concluida, Nome: "Concluídas", Total: Model.Concluidas, Cor: "success")
    };
}

<div class="py-3 py-md-4">
    <header class="painel-cabecalho rounded-4 p-4 p-md-5 mb-4">
        <h1 class="display-6 fw-bold mb-2">Painel da oficina</h1>
        <p class="mb-4">Acompanhe as ordens de serviço da abertura à conclusão.</p>
        <div class="d-flex flex-wrap gap-2">
            @if (User.IsInRole("Atendente"))
            {
                <a class="btn btn-light fw-semibold" asp-controller="Ordens" asp-action="Abrir">Nova ordem de serviço</a>
            }
            <a class="btn btn-outline-light" asp-controller="Clientes" asp-action="Index">Clientes</a>
            <a class="btn btn-outline-light" asp-controller="Veiculos" asp-action="Index">Veículos</a>
        </div>
    </header>

    <section class="mb-4" aria-labelledby="titulo-fluxo">
        <h2 id="titulo-fluxo" class="h5 mb-3">Fluxo das ordens de serviço</h2>
        <div class="row row-cols-1 row-cols-md-3 g-3">
            @foreach (var etapa in etapas)
            {
                <div class="col">
                    <a class="card h-100 shadow-sm text-decoration-none text-dark border-top border-4 border-@etapa.Cor"
                       asp-controller="Ordens" asp-action="Index" asp-route-status="@etapa.Status">
                        <div class="card-body d-flex justify-content-between align-items-center gap-2">
                            <span class="fw-semibold">@etapa.Nome</span>
                            <strong class="fs-3">@etapa.Total</strong>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>

    <section class="card shadow-sm rounded-4 mb-4" aria-labelledby="titulo-recentes">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h2 id="titulo-recentes" class="h5 mb-0">Ordens recentes</h2>
                <a asp-controller="Ordens" asp-action="Index">Ver todas as ordens</a>
            </div>
            @if (Model.OrdensRecentes.Count == 0)
            {
                <p class="text-muted mb-0">Ainda não há ordens de serviço cadastradas.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var ordem in Model.OrdensRecentes)
                    {
                        var etapa = etapas.First(item => item.Status == ordem.Status);
                        Model.Veiculos.TryGetValue(ordem.VeiculoId, out var veiculo);
                        <li class="list-group-item px-0 py-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div>
                                    <a class="fw-semibold" asp-controller="Ordens" asp-action="Detalhes"
                                       asp-route-numero="@ordem.Numero">Ordem #@ordem.Numero</a>
                                    <div class="small text-muted">
                                        @(veiculo is null ? "Veículo indisponível" : $"{veiculo.Placa} · {veiculo.Marca} {veiculo.Modelo}")
                                        · @ordem.DataAbertura.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                                <span class="badge rounded-pill text-bg-@etapa.Cor">@(ordem.Status switch
                                {
                                    StatusOrdem.Pendente => "Pendente",
                                    StatusOrdem.Concluida => "Concluída",
                                    _ => "Em andamento"
                                })</span>
                            </div>
                            <p class="mb-0 mt-2 text-break">@ordem.ProblemaRelatado</p>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
</div>
