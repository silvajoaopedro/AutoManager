<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoManager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AutoManager.styles.css" asp-append-version="true" />
</head>
<body class="oficina">
    @if (User.Identity?.IsAuthenticated == true)
    {
        var modulo = ViewContext.RouteData.Values["controller"]?.ToString();
        <aside class="offcanvas-lg offcanvas-start oficina-menu" tabindex="-1" id="menuOficina" aria-labelledby="marcaOficina">
            <div class="oficina-marca" id="marcaOficina"><span aria-hidden="true">A</span> AutoManager</div>
            <button class="btn-close btn-close-white d-lg-none oficina-fechar" type="button"
                    data-bs-dismiss="offcanvas" data-bs-target="#menuOficina" aria-label="Fechar menu"></button>
            <nav aria-label="Módulos da oficina">
                <a asp-controller="Home" asp-action="Index" aria-current="@(modulo == "Home" ? "page" : null)">Visão geral</a>
                <a asp-controller="Ordens" asp-action="Index" aria-current="@(modulo == "Ordens" ? "page" : null)">Ordens de serviço</a>
                <a asp-controller="Veiculos" asp-action="Index" aria-current="@(modulo == "Veiculos" ? "page" : null)">Veículos</a>
                <a asp-controller="Clientes" asp-action="Index" aria-current="@(modulo == "Clientes" ? "page" : null)">Clientes</a>
            </nav>
            <div class="oficina-perfil">
                <strong>@User.Identity.Name</strong>
                <span>@(User.IsInRole("Atendente") ? "Atendente" : "Mecânico")</span>
                <form asp-controller="Conta" asp-action="Sair" method="post" asp-antiforgery="true">
                    <button type="submit" class="btn btn-sm btn-outline-light">Sair</button>
                </form>
            </div>
        </aside>
        <div class="oficina-area">
            <header class="oficina-topo">
                <button class="btn oficina-menu-toggle d-lg-none" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#menuOficina" aria-controls="menuOficina" aria-label="Abrir menu">☰</button>
                <span class="oficina-local">Oficina <span aria-hidden="true">/</span> <strong>@ViewData["Title"]</strong></span>
                @if (User.IsInRole("Atendente"))
                {
                    <a class="btn oficina-nova" asp-controller="Ordens" asp-action="Abrir">
                        <span aria-hidden="true">+</span> <span class="d-none d-sm-inline">Nova ordem de serviço</span><span class="d-sm-none">Nova OS</span>
                    </a>
                }
            </header>
            <main class="oficina-conteudo">@RenderBody()</main>
        </div>
    }
    else
    {
        <header class="oficina-topo"><strong>AutoManager</strong></header>
        <main class="container py-4">@RenderBody()</main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
