@using System.Globalization
@inject AutoManager.Services.OficinaService Oficina
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoManager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AutoManager.styles.css" asp-append-version="true" />
</head>
<body class="oficina">
    @if (User.Identity?.IsAuthenticated == true)
    {
        var modulo = ViewContext.RouteData.Values["controller"]?.ToString();
        var ehAtendente = User.IsInRole("Atendente");
        var nomeUsuario = User.Identity.Name ?? "";
        var partesNome = nomeUsuario.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var iniciais = partesNome.Length switch
        {
            0 => "?",
            1 => partesNome[0][..Math.Min(2, partesNome[0].Length)],
            _ => $"{partesNome[0][0]}{partesNome[^1][0]}"
        };
        int? ordensAbertas = null;
        try
        {
            ordensAbertas = Oficina.ConsultarOrdens().Count(ordem => ordem.Status != StatusOrdem.Concluida);
        }
        catch (Exception)
        {
            // O contador do menu é opcional; a página continua sem ele.
        }
        var hoje = DateTime.Now.ToString("d MMM 'de' yyyy", CultureInfo.GetCultureInfo("pt-BR"));

        <aside class="offcanvas-lg offcanvas-start oficina-menu" tabindex="-1" id="menuOficina" aria-labelledby="marcaOficina">
            <div class="oficina-marca" id="marcaOficina">
                <span class="oficina-logo" aria-hidden="true">A</span>
                <span>
                    <strong>Auto<span>Manager</span></strong>
                    <small>Gestão da oficina</small>
                </span>
            </div>
            <button class="btn-close btn-close-white d-lg-none oficina-fechar" type="button"
                    data-bs-dismiss="offcanvas" data-bs-target="#menuOficina" aria-label="Fechar menu"></button>
            <nav aria-label="Módulos da oficina">
                <p class="oficina-secao">Principal</p>
                <a asp-controller="Home" asp-action="Index" aria-current="@(modulo == "Home" ? "page" : null)">
                    <partial name="_Icone" model="@("grade")" /> Visão geral
                </a>
                <a asp-controller="Ordens" asp-action="Index" aria-current="@(modulo == "Ordens" ? "page" : null)">
                    <partial name="_Icone" model="@("prancheta")" /> Ordens de serviço
                    @if (ordensAbertas > 0)
                    {
                        <span class="oficina-contador" title="Ordens em aberto">@ordensAbertas<span class="visually-hidden"> em aberto</span></span>
                    }
                </a>
                <a asp-controller="Veiculos" asp-action="Index" aria-current="@(modulo == "Veiculos" ? "page" : null)">
                    <partial name="_Icone" model="@("carro")" /> Veículos
                </a>
                <a asp-controller="Clientes" asp-action="Index" aria-current="@(modulo == "Clientes" ? "page" : null)">
                    <partial name="_Icone" model="@("pessoas")" /> Clientes
                </a>
            </nav>
            <div class="oficina-perfil">
                <span class="oficina-avatar" aria-hidden="true">@iniciais.ToUpperInvariant()</span>
                <span class="oficina-perfil-nome">
                    <strong>@nomeUsuario</strong>
                    <small>@(ehAtendente ? "Atendente" : "Mecânico")</small>
                </span>
                <form asp-controller="Conta" asp-action="Sair" method="post" asp-antiforgery="true">
                    <button type="submit" class="oficina-sair" title="Sair" aria-label="Sair">
                        <partial name="_Icone" model="@("sair")" />
                    </button>
                </form>
            </div>
        </aside>
        <div class="oficina-area">
            <header class="oficina-topo">
                <button class="oficina-menu-toggle d-lg-none" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#menuOficina" aria-controls="menuOficina" aria-label="Abrir menu">
                    <partial name="_Icone" model="@("menu")" />
                </button>
                <nav class="oficina-local" aria-label="Você está em">
                    <span>Oficina</span> <span class="oficina-local-sep" aria-hidden="true">/</span> <strong>@ViewData["Title"]</strong>
                </nav>
                <span class="oficina-data d-none d-sm-inline">@hoje</span>
                <span class="oficina-avatar oficina-avatar-topo d-none d-sm-inline-grid" title="@nomeUsuario" aria-hidden="true">@iniciais.ToUpperInvariant()</span>
            </header>
            <main class="oficina-conteudo">@RenderBody()</main>
        </div>
    }
    else
    {
        <header class="oficina-topo"><strong>AutoManager</strong></header>
        <main class="container py-4">@RenderBody()</main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
