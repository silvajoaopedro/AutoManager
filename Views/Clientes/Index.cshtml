@model IEnumerable<AutoManager.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
    bool podeEditar = User.IsInRole("Atendente");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Clientes</h1>

    @if (podeEditar)
    {
        <a asp-controller="Clientes"
           asp-action="Cadastrar"
           class="btn btn-primary">
            Cadastrar cliente
        </a>
    }
</div>

@if (TempData["Sucesso"] is string mensagem)
{
    <div class="alert alert-success" role="status">
        @mensagem
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info" role="status">
        Nenhum cliente cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col">Telefone</th>

                    @if (podeEditar)
                    {
                        <th scope="col">Ações</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Nome</td>
                        <td>@cliente.Telefone</td>

                        @if (podeEditar)
                        {
                            <td>
                                <a asp-controller="Clientes"
                                   asp-action="Editar"
                                   asp-route-id="@cliente.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Editar
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}